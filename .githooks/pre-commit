#!/bin/sh
# Local vault check. Runs the lint tests, the acceptance script tests and the
# vault lint before every commit. The GitHub Action in .github/workflows/lint.yml
# runs the same three steps on every push to main.
# Install once: git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"
python3 -m unittest discover lint -q
python3 -m unittest discover acceptance -q
python3 lint/vault_lint.py
